# ---
# title: Gitignore for Git Automatisation
# ---

# ---

# dia:file gitignore/base.ignore

# --- Base ---

# macOS
._*
.AppleDouble
.DS_Store
.LSOverride
.Spotlight-V100
.Trashes
* [0-9]
* [0-9].*
* copy
* copy.*
*.nosync/
Icon[[]]

# Linux
.nfs*
*~

# Windows
$RECYCLE.BIN/
Desktop.ini
ehthumbs.db
Thumbs.db

# Logs, temporary files, regenerable cache
*.bak
*.bak[0-9]*
*.bkp
*.log
*.swo
*.swp
*.tmp
log/
.log/
logs/
.logs/
tmp/
.tmp/
cache/
.cache/

# Local environment variables
.env
.env.*
