#!/bin/bash

# ---
# description: Runs an ordered Repolicy TSV catalog through an adapter.
# ---

# TSV columns: kind<TAB>target[<TAB>arg…]
# Kinds: cli/sanitiser (command on PATH), rule/action (adapter), attribute
# (path policy). The distinct sanitiser kind permits deliberate manual runs.
# Exit contract: 0 = clean, 3 = changed, 4 = findings, other = fatal.
# Findings and changes continue through the catalog and reject at the end.

set -o errexit
set -o pipefail

event="${1:?usage: run-repolicy-catalog <event> <file.tsv> [event-args…]}"
catalog="${2:?usage: run-repolicy-catalog <event> <file.tsv> [event-args…]}"
shift 2
event_args=("${@}")
findings_exit=4
changed_exit=3
catalog_findings=0
catalog_changed=0

runtime_root="${REPOLICY_LIBEXEC:-}"
if [ -z "${runtime_root}" ]; then
    runtime_root="$(CDPATH='' cd -- "$(dirname "${0}")" && pwd)"
fi
PATH="${runtime_root}:${PATH}"
export PATH REPOLICY_LIBEXEC="${runtime_root}"

# Installing Repolicy without configuring a catalog intentionally does nothing.
if [ ! -f "${catalog}" ]; then
    exit 0
fi

run_cli() {
    local cmd="$1"
    shift
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        log-warn "Skipping missing command: ${cmd}"
        return 0
    fi
    "${cmd}" "${@}"
}

run_adapter_step() {
    local kind="$1"
    local target="$2"
    shift 2
    local adapter="${runtime_root}/adapters/git-hooks/run-${kind}"
    if [ ! -x "${adapter}" ]; then
        log-error "Missing Repolicy Git adapter: ${adapter}"
        return 1
    fi
    "${adapter}" "${event}" "${target}" "${@}" -- "${event_args[@]}"
}

line_no=0
while IFS= read -r line || [ -n "${line}" ]; do
    line_no=$((line_no + 1))
    case "${line}" in
        '' | \#*) continue ;;
    esac

    kind=""
    target=""
    rest=""
    IFS=$'\t' read -r kind target rest <<< "${line}" || true
    if [ -z "${kind}" ] || [ -z "${target}" ]; then
        log-error "Bad catalog row ${line_no} in ${catalog}: need kind and target"
        exit 1
    fi

    row_args=()
    if [ -n "${rest}" ]; then
        IFS=$'\t' read -r -a row_args <<< "${rest}" || true
    fi

    step_status=0
    case "${kind}" in
        cli | sanitiser)
            run_cli "${target}" "${row_args[@]}" || step_status=$?
            ;;
        rule | action | attribute)
            run_adapter_step "${kind}" "${target}" "${row_args[@]}" || step_status=$?
            ;;
        *)
            log-error "Unknown catalog kind '${kind}' at ${catalog}:${line_no}"
            exit 1
            ;;
    esac

    case "${step_status}" in
        0) ;;
        "${findings_exit}")
            catalog_findings=1
            log-info "${target} reported findings; continuing policy checks."
            ;;
        "${changed_exit}")
            catalog_changed=1
            log-info "${target} modified files; continuing policy checks."
            ;;
        *)
            log-error \
                "Policy step failed at ${catalog}:${line_no}: ${target}" \
                "Exit status: ${step_status}"
            exit "${step_status}"
            ;;
    esac
done < "${catalog}"

if [ "${catalog_changed}" -ne 0 ]; then
    log-error \
        "Policy steps modified files; commit stopped after all checks." \
        "Review the diff, run:" \
        "  git add -u" \
        "Then commit again."
fi

if [ "${catalog_findings}" -ne 0 ]; then
    log-error "Policy checks reported findings; Git operation stopped after all checks."
    exit "${findings_exit}"
fi

[ "${catalog_changed}" -eq 0 ] || exit "${changed_exit}"
